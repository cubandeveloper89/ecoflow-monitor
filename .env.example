# Credenciales del EcoFlow Developer Platform (https://developer.ecoflow.com)
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
# Número de serie del equipo (lo ves en la app o en /api/devices)
ECOFLOW_SN=
# Host de la API: api.ecoflow.com (global), api-e.ecoflow.com (Europa), api-a.ecoflow.com (América)
ECOFLOW_API_HOST=https://api-a.ecoflow.com
# Puerto del servidor local
PORT=3030
# 1 = datos simulados (para desarrollar sin el equipo)
ECOFLOW_MOCK=0
